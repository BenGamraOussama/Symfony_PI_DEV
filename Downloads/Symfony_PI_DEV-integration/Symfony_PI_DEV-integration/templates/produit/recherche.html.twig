{% extends 'base.html.twig' %}

{% block title %}Résultats de recherche{% endblock %}

{% block body %}
    <h1>Résultats pour "{{ nomRecherche }}"</h1>

    {% if produits is not empty %}
        <div class="row">
            {% for produit in produits %}
                <div class="col-md-4">
                    <div class="card">
                        <img src="{{ asset(produit.image) }}" alt="{{ produit.nom }}" class="card-img-top">
                        <div class="card-body">
                            <h5 class="card-title">{{ produit.nom }}</h5>
                            <p class="card-text">{{ produit.description }}</p>
                            <p class="card-text">{{ produit.prix }} DT</p>
                            <a href="{{ path('ajouter_panier', {'id': produit.id}) }}" class="btn btn-primary">
                                Ajouter au panier
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p>Aucun produit trouvé pour "{{ nomRecherche }}".</p>
    {% endif %}
{% endblock %}
