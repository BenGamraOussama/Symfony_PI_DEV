
       {% extends 'basePatient.html.twig' %}

{% block title %}New Rendez-vous{% endblock %}

{% block body %}

        
        <!-- Start Search Layout -->
        <div class="search-overlay">
            <div class="d-table">
                <div class="d-table-cell">
                    <div class="search-overlay-layer"></div>
                    <div class="search-overlay-layer"></div>
                    <div class="search-overlay-layer"></div>
                    
                    <div class="search-overlay-close">
                        <span class="search-overlay-close-line"></span>
                        <span class="search-overlay-close-line"></span>
                    </div>

                    <div class="search-overlay-form">
                        <form>
                            <input type="text" class="input-search" placeholder="Search here...">
                            <button type="submit"><i class="flaticon-search"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <!-- End Search Layout -->
        
        <!-- Start Page Banner Area -->
        <div class="page-banner-area">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-lg-6 col-md-6">
                        <div class="page-banner-image">
                            <img src="{{asset('assetsP/images/page-banner/page-banner-3.jpg')}}" alt="image">

                            <div class="image-shape">
                                <img src="{{ asset('assetsP/images/page-banner/shape.png') }}" alt="image">
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6">
                        <div class="page-banner-content">
                            <h2>Online Booking</h2>
                            <ul>
                                <li>
                                    <a href="index.html">Home</a>
                                </li>
                                <li>Online Booking</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="page-banner-shape">
                <img src="{{asset('assetsP/images/page-banner/banner-shape-1.png')}}" alt="image">
            </div>
        </div>
        <!-- End Page Banner Area -->

       <!-- Start Book Online Area -->
<section class="book-online-area bg-ffffff ptb-100">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="book-online-form bg-top">
                   <h3>Book Our Online Session</h3>

{{ form_start(form, {'attr': {'id': 'addRDVForm', 'novalidate': 'novalidate'}}) }}
   
    <div class="form-group">
        {{ form_label(form.psychiatre, 'Psychiatre') }}
        {{ form_widget(form.psychiatre, {'attr': {'class': 'form-control', 'placeholder': 'Psychiatre', 'id': 'psychiatre'}}) }}
       
    </div>
    <div class="form-group">
        {{ form_label(form.heure, 'Heure') }}
        {{ form_widget(form.heure, {'attr': {'class': 'form-control', 'placeholder': 'Heure', 'id': 'heure'}}) }}
       
    </div>
    <div class="form-group">
                    {{ form_label(form.date) }}
                    {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
                   
                </div>

    <div class="book-online-btn">
        <button type="submit" class="default-btn">Book Online <i class="flaticon-pointer"></i></button>
    </div>

<!-- QR Code du psychiatre sélectionné -->
<div class="form-group">
    <h4>Scanner pour accéder à l'adresse</h4>
    <img id="qrCode" src="" alt="QR Code du psychiatre" style="width: 300px; display: none;">
</div>
{{ form_end(form) }}

                                     
                </div>
            </div>

            <div class="col-lg-6">
                <div class="book-online-image"></div>
            </div>
        </div>
    </div>

    <div class="book-main-shape">
        <img src="{{ asset('assetsP/images/book-online-shape.png') }}" alt="image">
    </div>
</section>
<!-- End Book Online Area -->
        <!-- Start Subscribe Area -->
        <div class="subscribe-area bg-top pt-100">
            <div class="container">
                <div class="subscribe-inner-box">
                    <div class="subscribe-content">
                        <h2>Subscribe Our Newsletter</h2>
                        <p>Lorem ipsum dolor sit amet consetetur sadipscing elitr sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat sed diam voluptua.</p>
    
                        <form class="newsletter-form" data-bs-toggle="validator" novalidate="true">
                            <div class="row">
                                <div class="col-lg-8 col-md-6">
                                    <input type="email" class="input-newsletter" placeholder="Enter your email" name="EMAIL" required="" autocomplete="off">
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <button type="submit" class="disabled" style="pointer-events: all; cursor: pointer;">Subscribe Now <i class="flaticon-paper-plane"></i></button>
                                    <div id="validator-newsletter" class="form-result"></div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <!-- End Subscribe Area -->

       

       

        <!-- Start Go Top Area -->
        <div class="go-top">
            <i class="flaticon-up-arrow"></i>
        </div>
        <!-- End Go Top Area -->
        
<script>
    document.getElementById('psychiatre').addEventListener('change', function () {
        var psychiatreId = this.value;
        console.log("Psychiatre sélectionné:", psychiatreId); // Afficher l'ID dans la console
        if (psychiatreId) {
            document.getElementById('qrCode').src = '/qr-code/' + psychiatreId;
            document.getElementById('qrCode').style.display = 'block';
        } else {
            document.getElementById('qrCode').style.display = 'none';
        }
    });
</script>

{% endblock %}