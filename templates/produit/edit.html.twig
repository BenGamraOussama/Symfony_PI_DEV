{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .form-container {
            margin: 2rem auto;
            max-width: 600px;
            background: #f9f9f9;
            padding: 1.5rem;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        h1 {
            text-align: center;
            margin-bottom: 1.5rem;
            font-size: 1.5rem;
        }

        label {
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        input[type="text"],
        input[type="number"],
        input[type="file"],
        textarea,
        select {
            width: 100%;
            padding: 0.75rem;
            margin-bottom: 1rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 0.95rem;
        }

        .btn-primary {
            display: block;
            width: 100%;
            background-color: #007bff;
            color: #fff;
            font-weight: 600;
            border: none;
            border-radius: 4px;
            padding: 0.75rem;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .btn-primary:hover {
            background-color: #0056b3;
        }

        .btn-secondary {
            display: block;
            text-align: center;
            margin-top: 1rem;
            background-color: #6c757d;
            color: #fff;
            text-decoration: none;
            padding: 0.5rem 1rem;
            border-radius: 4px;
            transition: background-color 0.3s ease;
        }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

        .text-center {
            margin-top: 1rem;
        }
    </style>
{% endblock %}

{% block title %}Modifier le produit{% endblock %}

{% block body %}
    <div class="form-container">
        <h1 class="text-center">Modifier le produit</h1>

        {{ form_start(form) }}

            {# Display global form errors #}
            {{ form_row(form.nom) }}

            {{ form_row(form.prix) }}

            <!-- Optional: Image preview -->

            {{ form_row(form.description) }}

            {{ form_row(form.categorie) }}

            {{ form_row(form.quantite) }}

            {{ form_row(form.disponible) }}

            <button type="submit" class="btn btn-primary">💾 Enregistrer</button>
        {{ form_end(form) }}

        <div class="text-center">
            <a href="{{ path('produit_index') }}" class="btn btn-secondary">↩ Retour à la liste</a>
        </div>
    </div>
{% endblock %}
