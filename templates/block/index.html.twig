{% extends 'basePatient.html.twig' %}

{% block title %}Account Blocked{% endblock %}

{% block body %}
<style>
    .bg-edit {
        background-color: #8e54e9;
    }
    .blocked-container {
        background-color: #f8f9fa;
        border-radius: 10px;
        padding: 30px;
        text-align: center;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    .blocked-container h1 {
        color: #dc3545;
        font-size: 2.5rem;
    }
    .blocked-container p {
        font-size: 1.2rem;
        color: #6c757d;
    }
    .contact-info {
        margin-top: 20px;
        font-size: 1rem;
        color: #343a40;
    }
    .contact-info a {
        color: #007bff;
        text-decoration: none;
    }
    .contact-info a:hover {
        text-decoration: underline;
    }
</style>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="blocked-container">
                <h1>Account Blocked</h1>
                <p>Your account has been blocked. Please contact support for further assistance.</p>
                <div class="contact-info">
                    <p>If you have any questions, please contact us at:</p>
                    <p><a href="mailto:novataeem@gmail.com">novataeem@gmail.com</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- End Copy Right Area -->
<!-- Start Go Top Area -->
<div class="go-top">
    <i class='flaticon-up-arrow'></i>
</div>
{% endblock %}