{% extends 'base.html.twig' %}

{% block title %}Admin{% endblock %}

{% block body %}
<div class="app">
    <div class="app-wrap">
        <div class="loader">
            <div class="h-100 d-flex justify-content-center">
                <div class="align-self-center">
                    <img src="{{ asset('assets/img/loader/loader.svg')}}" alt="loader">
                </div>
            </div>
        </div>
        <div class="app-container">
            <div class="app-main" id="main">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-12 m-b-30">
                            <div class="d-block d-sm-flex flex-nowrap align-items-center">
                                <div class="page-title mb-2 mb-sm-0">
                                    <h1>List des Psychiatres</h1>
                                </div>
                                <div class="ml-auto d-flex align-items-center">
                                    <nav>
                                        <ol class="breadcrumb p-0 m-b-0">
                                            <li class="breadcrumb-item">
                                                <a href="index.html"><i class="ti ti-home"></i></a>
                                            </li>
                                            <li class="breadcrumb-item">
                                                Tables
                                            </li>
                                            <li class="breadcrumb-item active text-primary" aria-current="page">List des Psychiatres</li>
                                        </ol>
                                    </nav>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="card card-statistics">
                                <div class="card-body">
                                    <div class="datatable-wrapper table-responsive">
                                        <table id="datatable" class="display compact table table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Email</th>
                                                    <th>N° tel</th>
                                                    <th>numLicence</th>
                                                    <th>Specialite</th>
                                                    <th>Adresse</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            {% for psychiatre in psychiatres %}
                                                <tr>
                                                    <td>{{ psychiatre.lastName }} {{ psychiatre.firstName }}</td>
                                                    <td>{{ psychiatre.email }}</td>
                                                    <td>{{ psychiatre.phone }}</td>
                                                    <td>{{ psychiatre.numLicence }}</td>
                                                    <td>{{ psychiatre.specialite }}</td>
                                                    <td>{{ psychiatre.adresse }}</td>
                                                    <td>
                                                        <form method="post" action="{{ path('app_psychiatre_block', {'id': psychiatre.id}) }}">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ psychiatre.id) }}">
                                                            <button class="btn btn-warning">Block</button>
                                                        </form>
                                                        <button class="btn btn-danger" data-toggle="modal" data-target="#defaultModal{{ psychiatre.id }}">Supprimer</button>
                                                        <div class="modal fade" id="defaultModal{{ psychiatre.id }}" tabindex="-1" role="dialog" aria-labelledby="defaultModal" aria-hidden="true">
                                                            <div class="modal-dialog" role="document">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title">Warning</h5>
                                                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                            <span aria-hidden="true">&times;</span>
                                                                        </button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        Are you sure you want to delete {{ psychiatre.firstName }} {{ psychiatre.lastName }} ?
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                                                                        <form method="post" action="{{ path('psychiatre_delete', {'id': psychiatre.id}) }}">
                                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ psychiatre.id) }}">
                                                                            <button class="btn btn-danger">Supprimer</button>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                            </tbody>
                                        </table>
                                        <pagination-controls style="text-align: right;" (pageChange)="p = $event"></pagination-controls>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}