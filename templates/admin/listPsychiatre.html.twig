                                <div class="card card-statistics">
                                    <div class="card-body">
                                        <div class="datatable-wrapper table-responsive">
                                            <table  id="datatable" class="display compact table table-striped table-bordered">
                                                <thead>
                                                    <tr>
                                                    <th>Name</th>
                                                    <th>Email</th>
                                                    <th>N° tel</th>
                                                    <th>numLicence</th>
                                                    <th>Specialite</th>
                                                    <th>Adresse</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            {% for psychiatre in psychiatres %}
                                                <tr>
                                                    <td>{{ psychiatre.lastName }} {{ psychiatre.firstName }}</td>
                                                    <td>{{ psychiatre.email }}</td>
                                                    <td>{{ psychiatre.phone }}</td>
                                                    <td>{{ psychiatre.numLicence }}</td>
                                                    <td>{{ psychiatre.specialite }}</td>
                                                    <td>{{ psychiatre.adresse }}</td>
                                                    <td>
                <!-- Boutons pour bloquer/débloquer -->
                {% if psychiatre.isBlocked %}
                    <form action="{{ path('app_psychiatre_unblock', {'id': psychiatre.id}) }}" method="POST" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('unblock' ~ psychiatre.id) }}">
                        <button type="submit" class="btn btn-success">Débloquer</button>
                    </form>
                {% else %}
                    <button class="btn btn-danger" data-toggle="modal" data-target="#actionModal" data-action="block" data-psychiatre-id="{{ psychiatre.id }}" data-psychiatre-name="{{ psychiatre.firstName }} {{ psychiatre.lastName }}">
                        Bloquer
                    </button>
                {% endif %}

                <!-- Bouton pour supprimer -->
                <button class="btn btn-danger" data-toggle="modal" data-target="#defaultModal">Supprimer</button>
                <div class="modal fade" id="defaultModal" tabindex="-1" role="dialog" aria-labelledby="defaultModal" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Warning</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                Are you sure you want to delete {{ psychiatre.firstName }} {{ psychiatre.lastName }}?
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
                                <form method="post" action="{{ path('psychiatre_delete', {'id': psychiatre.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ psychiatre.id) }}">
                                    <button class="btn btn-danger">Supprimer</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </td>
        </tr>
    {% endfor %}
</tbody>

<!-- Modal unique pour toutes les actions -->
<div class="modal fade" id="actionModal" tabindex="-1" role="dialog" aria-labelledby="actionModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="actionModalLabel">Confirmation</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Êtes-vous sûr de vouloir <span id="actionText"></span> <span id="psychiatreName"></span> ?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                <form id="actionForm" method="POST" style="display: inline;">
                    <input type="hidden" name="_token" id="csrfToken">
                    <button type="submit" class="btn btn-danger" id="confirmActionButton"></button>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Script pour gérer dynamiquement le modal -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        $('#actionModal').on('show.bs.modal', function (event) {
            const button = $(event.relatedTarget); // Bouton qui a déclenché le modal
            const action = button.data('action'); // Action (block/delete)
            const psychiatreId = button.data('psychiatre-id'); // ID du psychiatre
            const psychiatreName = button.data('psychiatre-name'); // Nom du psychiatre

            // Mettre à jour le texte du modal
            const actionText = action === 'block' ? 'bloquer' : 'supprimer';
            $('#actionText').text(actionText);
            $('#psychiatreName').text(psychiatreName);

            // Mettre à jour le formulaire d'action
            const actionUrl = action === 'block' 
                ? "{{ path('app_psychiatre_block', {'id': 'PSYCHIATRE_ID'}) }}".replace('PSYCHIATRE_ID', psychiatreId)
                : "{{ path('psychiatre_delete', {'id': 'PSYCHIATRE_ID'}) }}".replace('PSYCHIATRE_ID', psychiatreId);
            $('#actionForm').attr('action', actionUrl);

            // Mettre à jour le token CSRF
            const csrfToken = action === 'block' 
                ? "{{ csrf_token('block' ~ 'PSYCHIATRE_ID') }}".replace('PSYCHIATRE_ID', psychiatreId)
                : "{{ csrf_token('delete' ~ 'PSYCHIATRE_ID') }}".replace('PSYCHIATRE_ID', psychiatreId);
            $('#csrfToken').val(csrfToken);

            // Mettre à jour le texte du bouton de confirmation
            $('#confirmActionButton').text(action === 'block' ? 'Bloquer' : 'Supprimer');
        });
    });
</script></table>
