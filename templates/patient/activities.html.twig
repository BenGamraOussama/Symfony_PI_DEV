{% extends 'basePatient.html.twig' %}

{% block title %}My Activities{% endblock %}

{% block body %}
<div class="container my-5">
    <h2 class="text-center mb-5">Your Activities</h2>
    
    {# Filter Controls #}
    <div class="d-flex justify-content-between mb-4">
        {# Type Filters on the left #}
        <div class="btn-group" role="group">
            <button type="button" class="btn btn-outline-primary filter active" data-filter="all">All Types</button>
            {% set uniqueTypes = [] %}
            {% for activity in patientActivities %}
                {% if activity.type not in uniqueTypes %}
                    {% set uniqueTypes = uniqueTypes|merge([activity.type]) %}
                    <button type="button" class="btn btn-outline-primary filter" data-filter="{{ activity.type }}">
                        {{ activity.type|capitalize }}
                    </button>
                {% endif %}
            {% endfor %}
        </div>

        {# Status Filters on the right #}
        <div class="btn-group" role="group">
            {% set uniqueStatuses = [] %}
            {% for activity in patientActivities %}
                {% set status = activity.type == 'exercise' 
                    ? (activity.exercice and app.user.patient and activity.exercice.reponses|filter(r => r.patient == app.user.patient)|length > 0 ? 'answered' : 'pending') 
                    : activity.status %}
                {% if status not in uniqueStatuses %}
                    {% set uniqueStatuses = uniqueStatuses|merge([status]) %}
                {% endif %}
            {% endfor %}
            
            <button type="button" class="btn btn-outline-primary status-filter active" data-status-filter="all">All Statuses</button>
            {% for status in uniqueStatuses|sort %}
                <button type="button" class="btn btn-outline-primary status-filter" data-status-filter="{{ status }}">
                    {{ status|replace({'_': ' '})|title }}
                </button>
            {% endfor %}
        </div>
    </div>

    <div class="row g-4">
        {% for activity in patientActivities %}
            {% set activityStatus = activity.type == 'exercise' 
                ? (activity.exercice and app.user.patient and activity.exercice.reponses|filter(r => r.patient == app.user.patient)|length > 0 ? 'answered' : 'pending') 
                : activity.status %}
            
            <div class="col-md-4 activity-item" 
                 data-type="{{ activity.type }}"
                 data-status="{{ activityStatus }}">
                <div class="card h-100 shadow activity-card">
<img src="{{ asset('images/default-activity-image.png') }}" class="card-img-top" alt="Activity Image">
                    <div class="card-body">
                        <h5 class="card-title d-flex justify-content-between align-items-center">
                            {{ activity.titre }}
                            <div class="badge-container">
                                <span class="badge bg-info me-2">
                                    <i class="bi 
                                        {% if activity.type == 'exercise' %}bi-question-circle
                                        {% else %}bi-clipboard-check
                                        {% endif %} me-1"></i>
                                    {{ activity.type|capitalize }}
                                </span>
                                <span class="badge 
                                    {% if activityStatus == 'answered' %}bg-success
                                    {% elseif activityStatus == 'pending' %}bg-warning
                                    {% elseif activityStatus == 'not_started' %}bg-secondary
                                    {% elseif activityStatus == 'in_progress' %}bg-warning text-dark
                                    {% elseif activityStatus == 'completed' %}bg-success
                                    {% endif %}">
                                    {{ activityStatus|replace({'_': ' '})|title }}
                                </span>
                            </div>
                        </h5>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info">No activities assigned yet.</div>
            </div>
        {% endfor %}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    let selectedType = 'all';
    let selectedStatus = 'all';

    const filterButtons = document.querySelectorAll('.filter');
    const statusFilterButtons = document.querySelectorAll('.status-filter');
    const activityItems = document.querySelectorAll('.activity-item');

    function updateFilters() {
        activityItems.forEach(item => {
            const typeMatch = selectedType === 'all' || item.dataset.type === selectedType;
            const statusMatch = selectedStatus === 'all' || item.dataset.status === selectedStatus;
            item.style.display = typeMatch && statusMatch ? 'block' : 'none';
        });
    }

    filterButtons.forEach(button => {
        button.addEventListener('click', function() {
            filterButtons.forEach(btn => btn.classList.remove('active'));
            this.classList.add('active');
            selectedType = this.dataset.filter;
            updateFilters();
        });
    });

    statusFilterButtons.forEach(button => {
        button.addEventListener('click', function() {
            statusFilterButtons.forEach(btn => btn.classList.remove('active'));
            this.classList.add('active');
            selectedStatus = this.dataset.statusFilter;
            updateFilters();
        });
    });
});
</script>

<style>
.filter, .status-filter {
    transition: all 0.2s ease;
}
.filter.active, .status-filter.active {
    background-color: #0d6efd;
    color: white !important;
    border-color: #0d6efd;
}
.btn-group {
    margin-right: 0.5rem;
    margin-bottom: 0.5rem;
}
.activity-card {
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    border: 1px solid rgba(0,0,0,0.125);
}
.activity-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
}
.badge {
    font-size: 0.85rem;
    padding: 0.5em 0.75em;
    display: inline-flex;
    align-items: center;
}
.card-title {
    font-size: 1.1rem;
    font-weight: 500;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}
.badge-container {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: flex-end;
}
.card-img-top {
    height: 200px;
    object-fit: cover;
}
</style>

{% endblock %}
