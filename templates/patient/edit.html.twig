{% block body %}
<style>
.form-check{position:relative;display:block;padding-left:1.25rem}.form-check-input{position:absolute;margin-top:.3rem;margin-left:-1.25rem}.form-check-input:disabled~.form-check-label{color:#6c757d}.form-check-label{margin-bottom:0}.form-check-inline{display:inline-flex;align-items:center;padding-left:0;margin-right:.75rem}.form-check-inline .form-check-input{position:static;margin-top:0;margin-right:.3125rem;margin-left:0}
.modal {
  display: none; /* Masquée par défaut */
  position: fixed;
  z-index: 1;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: auto;
  background-color: rgba(0, 0, 0, 0.5);
}

/* Contenu de la modal */
.modal-content {
  position: relative;
  background-color: #fff;
  margin: 15% auto;
  padding: 20px;
  border: 1px solid #888;
  width: 80%;
  max-width: 500px;
  border-radius: 10px;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
  animation: slideIn 0.5s ease-out;
}

/* Animation d'entrée de la modal */
@keyframes slideIn {
  from {
    transform: translateY(-50px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* Bouton de fermeture */
.close {
  position: absolute;
  right: 10px;
  top: 10px;
  font-size: 24px;
  font-weight: bold;
  cursor: pointer;
  color: #ff6b6b;
  transition: color 0.3s ease;
}

.close:hover {
  color: #ff4757;
}

/* Conteneur pour les cœurs */
.hearts-container {
  position: absolute;
  top: -50px;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  height: 50px;
}

/* Style des cœurs */
.heart {
  position: absolute;
  width: 20px;
  height: 20px;
  background-color: #ff6b6b;
  transform: rotate(-45deg);
  animation: float 5s infinite ease-in-out;
}

.heart::before,
.heart::after {
  content: '';
  position: absolute;
  width: 20px;
  height: 20px;
  background-color: #ff6b6b;
  border-radius: 50%;
}

.heart::before {
  top: -10px;
  left: 0;
}

.heart::after {
  top: 0;
  left: 10px;
}

/* Animation de flottement des cœurs */
@keyframes float {
  0%, 100% {
    transform: translateY(0) rotate(-45deg);
  }
  50% {
    transform: translateY(-20px) rotate(-45deg);
  }
}

/* Positionnement des cœurs */
.heart:nth-child(1) {
  left: 10%;
  animation-delay: 0s;
}

.heart:nth-child(2) {
  left: 30%;
  animation-delay: 1s;
}

.heart:nth-child(3) {
  left: 50%;
  animation-delay: 2s;
}

.heart:nth-child(4) {
  left: 70%;
  animation-delay: 3s;
}

.heart:nth-child(5) {
  left: 90%;
  animation-delay: 4s;
}
