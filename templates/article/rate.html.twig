{# templates/article/rate.html.twig #}
{% extends 'basePatient.html.twig' %}

{% block title %}Rate Article{% endblock %}

{% block body %}
<div class="app">
    <div class="app-wrap">

        <!-- If you have a loader, keep it -->
        <div class="loader">
            <div class="h-100 d-flex justify-content-center"></div>
        </div>
        
        <header></header> {# Possibly your patient header #}

        <div class="app-container">
            <div class="app-main" id="main">
                <div class="container-fluid py-5">

                    <!-- Title Row -->
                    <div class="row justify-content-center mb-4">
                        <div class="col-md-8 text-center">
                            <h1 class="text-primary fw-bold">Rate Article: <span class="text-dark">{{ article.title }}</span></h1>
                            <p class="text-muted">Please choose a rating below</p>
                        </div>
                    </div>

                    <!-- Card Row -->
                    <div class="row justify-content-center">
                        <div class="col-md-6">
                            <div class="card shadow-lg border-0 rounded-3">
                                <div class="card-body p-4">

                                    <!-- The Symfony Form -->
                                    {{ form_start(form) }}
                                        <div class="mb-3">
                                            {{ form_widget(form) }}
                                        </div>
                                        <button type="submit" class="btn btn-primary px-4">
                                            <i class="fas fa-star"></i> Submit Rating
                                        </button>
                                    {{ form_end(form) }}

                                    <!-- Back Link -->
                                    <div class="mt-3">
                                        <a href="{{ path('app_article_show_front', { id: article.id }) }}" class="btn btn-outline-secondary">
                                            <i class="fas fa-arrow-left"></i> Back to Article
                                        </a>
                                    </div>

                                </div> <!-- end card-body -->
                            </div> <!-- end card -->
                        </div>
                    </div> <!-- end row -->
                </div>
            </div>
        </div>

        <footer></footer>
    </div>
</div>
{% endblock %}
