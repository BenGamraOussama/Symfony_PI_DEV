{{ form_start(form, {'attr': {'id': 'responseForm'}}) }}
    {{ form_widget(form) }}
    <button class="btn" type="submit">Save</button>
{{ form_end(form) }}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        let form = document.getElementById('responseForm');
        let responseInput = document.querySelector("textarea[name='reponse']");
        let badWords = ["badword1", "badword2", "badword3"]; // Add more words

        form.addEventListener('submit', function (event) {
            let responseText = responseInput.value.toLowerCase();
            
            for (let i = 0; i < badWords.length; i++) {
                if (responseText.includes(badWords[i])) {
                    alert("Your response contains inappropriate words and cannot be submitted.");
                    event.preventDefault(); // Stop form submission
                    return;
                }
            }
        });
    });
</script>