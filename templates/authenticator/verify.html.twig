{% extends 'basePatient.html.twig' %}

{% block title %}Verify{% endblock %}

{% block body %}
    <h1>Verify</h1>

    <form method="post">
        <label for="otp">OTP Code</label>
        <input id="otp" type="text" name="otp" />
        <button type="submit">Verify</button>
    </form>

    {% if result is not null %}
        {% if result == true %}
            <p>Le code correct. Redirection en cours...</p>
            <script>
                window.location.href = "{{ path('app_home') }}";
            </script>
        {% else %}
            <p>C'est pas bon</p>
        {% endif %}
    {% endif %}
{% endblock %}